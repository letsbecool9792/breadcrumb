# Copy this file to server/.env and fill it in. .env is gitignored; this is not,
# so never put a real password here.

# Atlas connection string. In the Atlas UI: your cluster → Connect → Drivers →
# Node.js, then copy the string and put the database user's password in place of
# <db_password>. If the password contains @ : / ? # % & or a space, URL-encode it
# (@ becomes %40) -- an un-encoded one is read as part of the host and fails with
# a confusing error. Network Access must also allow this machine's IP.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=breadcrumb

# Database inside that cluster. Tests use this name with "_test" appended, so
# running them never touches real memories.
MONGODB_DB=breadcrumb

# Gemini API key, from https://aistudio.google.com/apikey -> Create API key.
# Used for the ingest pass (step 3.3) and, later, query parsing and embeddings.
# Note what the free tier costs you: Google may use free-tier content to improve
# its products. Enabling billing on the key's project puts it on the paid tier,
# where it is not used that way.
GEMINI_API_KEY=

# Optional. The models to use, when the pinned defaults do not suit -- free-tier
# daily allowances differ enormously by model (gemini-3.8-flash allows only 20
# ingest calls a day; older and lighter models far more). Check yours at
# https://aistudio.google.com/rate-limit with "All models" switched on.
# Must name a version: an alias like gemini-flash-latest is refused, since its
# behaviour would shift under you between runs.
# GEMINI_INGEST_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional. HOST only needs changing if something other than adb reverse has to
# reach the server; PORT must match the port used by adb reverse.
# PORT=3000
# HOST=127.0.0.1
