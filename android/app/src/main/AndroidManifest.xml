<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".BreadcrumbApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Breadcrumb">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Breadcrumb.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share sheet target. excludeFromRecents + noHistory + empty
             taskAffinity keep it out of the recents list and off the back
             stack, so it never appears to be "the app" the user opened. -->
        <activity
            android:name=".capture.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/app_name"
            android:theme="@style/Theme.Breadcrumb.Capture">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <!-- text/html too: some apps share rich text for links.
                     Cheap to accept, and EXTRA_TEXT still carries the plain
                     fallback that is actually read. -->
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
            </intent-filter>

            <!-- Selection toolbar. Selecting text anywhere in Android and
                 tapping Breadcrumb saves it, with no share sheet involved. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Images and PDFs, one or many. A photo shared with a caption
             arrives here too, with the caption in EXTRA_TEXT. -->
        <activity
            android:name=".capture.MediaReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/app_name"
            android:theme="@style/Theme.Breadcrumb.CaptureTranslucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>

</manifest>