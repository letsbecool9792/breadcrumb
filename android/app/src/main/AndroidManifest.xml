<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The backend, and saved links' pages. Capture never waits on either
         (architecture rule 2). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Whether the phone is online, so a link whose page cannot be reached
         is told apart from a phone that has lost its network. WorkManager
         declares it too; declared here because the app reads it itself. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Makes launchable apps visible, so a capture can record its source
         app's name. Without this, Android 11+ hides most packages: WhatsApp
         only became visible by granting access to a shared file, and Chrome,
         sharing plain text, was not visible at all (checked with
         dumpsys package queries). Launcher-intent queries cover every app a
         person could have shared from, without the policy-restricted
         QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BreadcrumbApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Breadcrumb">
        <!-- adjustResize: the search field sits just above the keyboard, as
             design board 2 draws it, rather than the whole window panning. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Breadcrumb.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share sheet target. excludeFromRecents + noHistory + empty
             taskAffinity keep it out of the recents list and off the back
             stack, so it never appears to be "the app" the user opened.
             Every capture activity handles its own config changes: a rotation
             mid-save would otherwise recreate it and drop the capture sheet.
             adjustResize on each, so the sheet rides up on the keyboard while
             a note is written. -->
        <activity
            android:name=".capture.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Breadcrumb.Capture">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <!-- text/html too: some apps share rich text for links.
                     Cheap to accept, and EXTRA_TEXT still carries the plain
                     fallback that is actually read. -->
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
            </intent-filter>

            <!-- Selection toolbar. Selecting text anywhere in Android and
                 tapping Breadcrumb saves it, with no share sheet involved. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Images and PDFs, one or many. A photo shared with a caption
             arrives here too, with the caption in EXTRA_TEXT. -->
        <activity
            android:name=".capture.MediaReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Breadcrumb.Capture">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Reads the clipboard for the Quick Settings tile. Not exported: only
             our own tile launches it. Its window must gain focus before Android
             will hand over the clipboard. -->
        <activity
            android:name=".capture.ClipboardCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Breadcrumb.Capture" />

        <!-- Hands a stored original to the app that opens it (step 4.5).
             Originals are app-private (architecture rule 1), so another app
             can only read one through a content URI granted for that one
             intent. Not exported: grants are the only way in. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.originals"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/originals_paths" />
        </provider>

        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_crumb"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>