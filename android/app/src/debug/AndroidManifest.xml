<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <!-- Debug-only. Accepts every mime type so it shows up in any share
             sheet, purely to report what the sending app actually sends.
             Never present in a release build. -->
        <activity
            android:name=".capture.ShareProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:label="Breadcrumb probe"
            android:theme="@style/Theme.Breadcrumb.Capture"
            tools:ignore="HardcodedText">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
